# ==================================================
# VES Campus Clash - Root .gitignore
# React + Laravel Monorepo
# ==================================================

############################
# Logs
############################
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

############################
# Dependencies
############################
frontend/node_modules/
backend/node_modules/
backend/vendor/

############################
# Build Output
############################
#frontend/dist/  
frontend/dist-ssr/
frontend/.vite/

backend/public/build/
backend/public/hot/
backend/public/storage/

############################
# Laravel Storage
############################
backend/storage/*.key
backend/storage/pail/
backend/storage/logs/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/testing/*
backend/storage/framework/views/*

backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitignore

############################
# Environment Files
############################
# But keep examples
!.env.example
.env
.env.*
frontend/.env
frontend/.env.*
backend/.env
backend/.env.*
backend/.env.backup
backend/.env.production

############################
# Local Config
############################
*.local
.phpactor.json
.phpunit.cache
.phpunit.result.cache
auth.json

############################
# Laravel Homestead
############################
backend/Homestead.json
backend/Homestead.yaml

############################
# IDE / Editors
############################
.vscode/*
!.vscode/extensions.json

.idea/
.fleet/
.nova/
.zed/

############################
# Operating System
############################
.DS_Store
Thumbs.db
desktop.ini

############################
# Visual Studio
############################
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

############################
# Coverage
############################
coverage/
.nyc_output/

############################
# Archives
############################
*.zip
*.rar
*.7z
*.tar
*.gz

############################
# Temporary Files
############################
*.tmp
*.temp
*.bak

############################
# Documentation Assets
############################
docs/screenshots/*.psd
docs/screenshots/*.ai